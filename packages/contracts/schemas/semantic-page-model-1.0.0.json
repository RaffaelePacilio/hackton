{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aua.dev/schemas/semantic-page-model-1.0.0.json",
  "title": "SemanticPageModel",
  "type": "object",
  "required": ["version", "page", "regions", "forms", "navigation", "actions", "dialogs", "errors", "visibleElements", "modelId", "generation"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": "1.0.0" },
    "page": {
      "type": "object",
      "required": ["url", "title", "route", "capturedAt"],
      "additionalProperties": false,
      "properties": {
        "url":         { "type": "string" },
        "title":       { "type": "string" },
        "route":       { "type": "string" },
        "mainIntent":  { "type": "string" },
        "capturedAt":  { "type": "string" }
      }
    },
    "regions":         { "type": "array", "items": { "$ref": "#/definitions/semanticElement" } },
    "forms":           { "type": "array", "items": { "$ref": "#/definitions/semanticElement" } },
    "navigation":      { "type": "array", "items": { "$ref": "#/definitions/semanticElement" } },
    "actions":         { "type": "array", "items": { "$ref": "#/definitions/semanticElement" } },
    "dialogs":         { "type": "array", "items": { "$ref": "#/definitions/semanticElement" } },
    "errors":          { "type": "array", "items": { "$ref": "#/definitions/semanticElement" } },
    "visibleElements": { "type": "array", "items": { "type": "string" } },
    "modelId":         { "type": "string" },
    "generation":      { "type": "integer" }
  },
  "definitions": {
    "semanticElement": {
      "type": "object",
      "required": ["id", "role", "accessibleName", "requiredCapabilities", "visible", "focusable", "geometry", "sensitive", "confidence", "provenance"],
      "additionalProperties": false,
      "properties": {
        "id":                   { "type": "string" },
        "role":                 { "type": "string" },
        "accessibleName":       { "type": "string" },
        "probableBusinessIntent": { "type": "string" },
        "requiredCapabilities": { "type": "array", "items": { "type": "string" } },
        "visible":              { "type": "boolean" },
        "focusable":            { "type": "boolean" },
        "geometry": {
          "type": "object",
          "required": ["x", "y", "width", "height"],
          "additionalProperties": false,
          "properties": {
            "x":      { "type": "number" },
            "y":      { "type": "number" },
            "width":  { "type": "number" },
            "height": { "type": "number" }
          }
        },
        "state": {
          "type": "object",
          "additionalProperties": { "type": ["string", "number", "boolean"] }
        },
        "validation": {
          "type": "object",
          "required": ["valid"],
          "additionalProperties": false,
          "properties": {
            "valid":    { "type": "boolean" },
            "messages": { "type": "array", "items": { "type": "string" } }
          }
        },
        "relationships": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "labelledBy":  { "type": "array", "items": { "type": "string" } },
            "describedBy": { "type": "array", "items": { "type": "string" } },
            "controls":    { "type": "array", "items": { "type": "string" } },
            "formOwner":   { "type": "string" }
          }
        },
        "sensitive":  { "type": "boolean" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "provenance": { "type": "string", "enum": ["dom", "aria", "heuristic", "framework-adapter"] }
      }
    }
  }
}
