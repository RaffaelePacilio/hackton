{
  "id": "replace_drag",
  "version": "1.0.0",
  "purpose": "Override a drag-and-drop interaction on a target element with an accessible alternative: a keyboard-operable move mechanism using arrow keys or a context-menu-style action list.",
  "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": ["elementId"],
    "additionalProperties": false,
    "properties": {
      "elementId": { "type": "string", "description": "SemanticElement.id of the draggable element" },
      "dropTargetIds": {
        "type": "array",
        "items": { "type": "string" },
        "description": "SemanticElement.ids of valid drop targets; auto-detected if omitted"
      }
    }
  },
  "preconditions": [
    "Element with matching id exists in the current SemanticPageModel",
    "Element has drag interaction detected (role=row with drag handle, or equivalent)"
  ],
  "permissions": ["WRITE_LOW_RISK"],
  "sideEffects": ["event-handler-override", "dom-mutation"],
  "outputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": ["replaced"],
    "properties": {
      "replaced": { "type": "boolean" },
      "alternativeId": { "type": "string" }
    }
  },
  "errorModel": [
    { "code": "ELEMENT_NOT_FOUND", "retryable": false },
    { "code": "NO_DRAG_DETECTED", "retryable": false },
    { "code": "OVERRIDE_BLOCKED", "retryable": false }
  ],
  "rollback": "supported",
  "verificationStrategy": "accessibility-check",
  "telemetry": {
    "emits": [
      "aua.skill.replace_drag.invoked",
      "aua.skill.replace_drag.completed",
      "aua.skill.replace_drag.rolled_back"
    ]
  },
  "securityClassification": "WRITE_LOW_RISK"
}
