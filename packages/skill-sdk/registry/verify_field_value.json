{
  "id": "verify_field_value",
  "version": "1.0.0",
  "purpose": "Read a form field's current value from the DOM and compare it against an expected value to confirm a prior fill action succeeded.",
  "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": ["elementId", "expectedValue"],
    "additionalProperties": false,
    "properties": {
      "elementId": { "type": "string", "description": "SemanticElement.id of the field" },
      "expectedValue": { "type": "string" }
    }
  },
  "preconditions": [
    "Element with matching id exists in the current SemanticPageModel",
    "Element is a form field with a readable value"
  ],
  "permissions": ["READ"],
  "sideEffects": [],
  "outputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": ["verified", "observedValue"],
    "properties": {
      "verified": { "type": "boolean" },
      "observedValue": { "type": "string" },
      "expectedValue": { "type": "string" }
    }
  },
  "errorModel": [
    { "code": "ELEMENT_NOT_FOUND", "retryable": false },
    { "code": "VALUE_READ_TIMEOUT", "retryable": true }
  ],
  "rollback": "not-applicable",
  "verificationStrategy": "dom-read",
  "telemetry": {
    "emits": [
      "aua.skill.verify_field_value.invoked",
      "aua.skill.verify_field_value.completed"
    ]
  },
  "securityClassification": "READ"
}
